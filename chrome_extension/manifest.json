{
  "manifest_version": 3,
  "name": "SecureNet Shield",
  "version": "2.0",
  "permissions": [
  "tabs",
  "scripting",
  "activeTab",
  "storage"
],
  "host_permissions": ["<all_urls>"],
   "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
  {
    "resources": ["blocked.html","checking.html"],
    "matches": ["<all_urls>"]
  }
  ],
  "background": {
    "service_worker": "background.js"
  }
}